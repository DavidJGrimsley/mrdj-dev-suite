{
  "name": "@mr.dj2u/framework-registry",
  "version": "0.1.0",
  "description": "Browser-safe typed framework registry, template catalog, and plan contracts for iSquared and MDS",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidJGrimsley/mrdj-dev-suite.git",
    "directory": "packages/framework-registry"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run --passWithNoTests",
    "prepack": "node ../../scripts/verify-publish-manifest.mjs .",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','tsconfig.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "isquared",
    "exact",
    "expo",
    "framework-registry",
    "templates",
    "generator"
  ],
  "author": "DJ",
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  }
}
