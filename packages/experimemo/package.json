{
  "name": "experimemo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "mds:continue": "npx mds continue",
    "mds:doctor": "npx mds doctor",
    "mds:doctor:ci": "npx mds doctor --ci",
    "mds:stylist:sync": "npx mds stylist sync .",
    "stylist:sync:android": "node ./scripts/stylist-sync-android.mjs",
    "mds:eject": "npx mds eject .",
    "mds:eject:exposition": "npx mds eject exposition .",
    "mds:eject:stylist": "npx mds eject stylist .",
    "free-port": "npx mds free-port",
    "clear-expo-start": "npx mds clear-expo-start",
    "expo-install-fix": "npx expo install --fix",
    "expo-doctor": "npx expo-doctor",
    "post-create-check": "npx expo install --fix && npx expo-doctor",
    "ci:verify": "npx mds doctor --ci",
    "test": "pnpm lint && pnpm typecheck",
    "serve:prod": "npx expo serve",
    "serve:prod:fresh": "npx mds free-port 8081 && pnpm build:web && npx expo serve"
  },
  "dependencies": {
    "expo-navigation-bar": "~56.0.3",
    "expo-splash-screen": "~56.0.10",
    "zustand": "^4.5.1",
    "expo-sqlite": "~56.0.4",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-worklets": "0.8.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "reanimated-color-picker": "^4.2.0",
    "@expo/log-box": "^56.0.12",
    "@expo/vector-icons": "^15.0.2",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.11",
    "expo-router": "~56.2.6",
    "expo-constants": "~56.0.15",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "react-native-safe-area-context": "~5.7.0",
    "expo": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@react-native/metro-config": "0.85.3",
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3",
    "tailwindcss": "^4.2.4",
    "@mr.dj2u/cli": "^0.2.1"
  },
  "private": true
}
