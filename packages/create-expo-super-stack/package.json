{
  "name": "create-expo-super-stack",
  "version": "0.2.0",
  "description": "Opinionated MDS wrapper around create-expo-stack with rich Expo onboarding",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidJGrimsley/mrdj-dev-suite.git",
    "directory": "packages/create-expo-super-stack"
  },
  "bin": {
    "create-expo-super-stack": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "scripts": {
    "build": "pnpm --filter @mr.dj2u/cli build && tsc",
    "type-check": "pnpm --filter @mr.dj2u/cli build && tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "prepack": "node ../../scripts/verify-publish-manifest.mjs .",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','tsconfig.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@mr.dj2u/cli": "^0.3.0",
    "@mr.dj2u/create-expo-stack": "2.21.3-mrdj.2",
    "create-expo-stack": "^2.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "expo",
    "create-expo-stack",
    "uniwind",
    "mds",
    "react-native"
  ],
  "author": "DJ",
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  }
}
