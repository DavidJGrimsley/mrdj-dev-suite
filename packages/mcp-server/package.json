{
  "name": "@mr.dj2u/mcp-server",
  "version": "0.1.16",
  "description": "MCP server for mds suite (Claude integration point)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidJGrimsley/mrdj-dev-suite.git",
    "directory": "packages/mcp-server"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./resources": {
      "import": "./dist/resources/index.js",
      "types": "./dist/resources/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-server": "./dist/stdio.js",
    "mds-mcp-server": "./dist/stdio.js"
  },
  "scripts": {
    "build": "pnpm --filter @mr.dj2u/cli build && tsc",
    "type-check": "pnpm --filter @mr.dj2u/cli build && tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "pnpm --filter @mr.dj2u/cli build && tsc && vitest run --passWithNoTests",
    "prepack": "node ../../scripts/verify-publish-manifest.mjs .",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','tsconfig.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@mr.dj2u/cli": "^0.1.26",
    "@mr.dj2u/doctor": "^0.1.7",
    "@mr.dj2u/knowledge": "^0.1.8",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "expo"
  ],
  "author": "DJ",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
