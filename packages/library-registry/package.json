{
  "name": "@mr.dj2u/library-registry",
  "version": "0.1.0",
  "description": "Typed source-copy registry for reusable Expo components, screens, flows, and integrations",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidJGrimsley/mrdj-dev-suite.git",
    "directory": "packages/library-registry"
  },
  "files": [
    "dist",
    "assets",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run --passWithNoTests",
    "prepack": "node ../../scripts/verify-publish-manifest.mjs .",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','tsconfig.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "expo",
    "react-native",
    "components",
    "registry",
    "templates"
  ],
  "author": "DJ",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
