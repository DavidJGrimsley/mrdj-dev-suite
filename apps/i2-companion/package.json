{
  "name": "i2-companion",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node tools/compat/prepare-uri-decoder.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "build:android": "expo export --platform android --max-workers 2",
    "build:ios": "expo export --platform ios --max-workers 2",
    "mds:continue": "npx mds continue",
    "mds:doctor": "npx mds doctor",
    "mds:doctor:ci": "npx mds doctor --ci",
    "react:check": "npx react-doctor -y --no-telemetry",
    "mds:react-doctor": "npx mds run react-doctor",
    "free-port": "npx mds free-port",
    "clear-expo-start": "npx mds clear-expo-start",
    "expo-install-fix": "npx expo install --fix",
    "expo-doctor": "npx expo-doctor",
    "post-create-check": "npx expo install --fix && npx expo-doctor",
    "ci:verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build:web",
    "test:unit": "node --import ./tests/node-ts-loader.mjs --experimental-strip-types --test tests/*.test.ts",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "serve:web": "node tools/web/serve-static.mjs"
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reactvision/react-viro": "3.0.3",
    "decode-uri-component": "0.5.0",
    "expo": "~57.0.33",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.14",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.0",
    "lucide-react-native": "^0.511.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "three": "0.186.1",
    "uniwind": "^1.14.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@mr.dj2u/cli": "^0.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.2",
    "@types/three": "^0.183.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "query-string@7.1.3": {
      "decode-uri-component": "$decode-uri-component"
    },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
