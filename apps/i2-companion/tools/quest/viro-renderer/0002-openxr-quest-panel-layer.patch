         (viewState.viewStateFlags & XR_VIEW_STATE_POSITION_VALID_BIT) &&
         (viewState.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT);
 
+    // App panel underlay (QuestPanelLayer.h). Prepare before rendering eyes so
+    // the OpenXR display clears alpha to 0 while the panel is submitted, allowing
+    // HDR tone-mapping (VROToneMappingRenderPass) to preserve the zero-alpha hole.
+    const XrCompositionLayerBaseHeader *questPanel = nullptr;
