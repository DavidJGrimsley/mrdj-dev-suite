     }
 
+    // Floating transparent branded title overlay (QuestPanelLayer.h), over the scene.
+    const XrCompositionLayerBaseHeader *questTitlePanel = nullptr;
+    if (viewsValid && frameState.shouldRender && _questPanel) {
+        questTitlePanel = _questPanel->prepareTitle(_session, _stageSpace);
+    }
+    if (questTitlePanel) layers.push_back(questTitlePanel);
