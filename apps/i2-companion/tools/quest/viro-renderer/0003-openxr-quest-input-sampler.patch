+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_expo_modules_questinput_QuestInputModule_nativeDiagDraw(
+        JNIEnv *env, jobject, jbyteArray rgba, jint width, jint height, jfloat widthM,
+        jfloat heightM, jfloatArray pose) {
+    XrPosef next;
+    const size_t totalBytes = (width > 0 && height > 0)
+        ? static_cast<size_t>(width) * static_cast<size_t>(height) * 4u
+        : 0u;
+    if (rgba == nullptr || width < 1 || height < 1 || width > 4096 || height > 4096 ||
+        static_cast<size_t>(env->GetArrayLength(rgba)) != totalBytes ||
+        !std::isfinite(widthM) || widthM <= 0 || widthM > 2.0f ||
+        !std::isfinite(heightM) || heightM <= 0 || heightM > 2.0f ||
+        !quest_input::readDiagPose(env, pose, &next)) return JNI_FALSE;
+    std::lock_guard<std::mutex> lock(quest_input::diagState.mutex);
+    auto &s = quest_input::diagState;
+    s.width = width; s.height = height;
+    s.widthM = widthM; s.heightM = heightM;
+    s.pose = next;
+    s.pixels.resize(totalBytes);
+    s.scratch.resize(totalBytes);
+    env->GetByteArrayRegion(rgba, 0, static_cast<jsize>(totalBytes),
+                            reinterpret_cast<jbyte *>(s.scratch.data()));
+    const size_t rowBytes = static_cast<size_t>(width) * 4u;
+    for (int y = 0; y < height; ++y) {
+        std::memcpy(s.pixels.data() + static_cast<size_t>(height - y - 1) * rowBytes,
+                    s.scratch.data() + static_cast<size_t>(y) * rowBytes,
+                    rowBytes);
+    }
+    s.pendingDirty = {0, 0, width, height};
+    s.visible = true; ++s.revision;
+    return JNI_TRUE;
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_expo_modules_questinput_QuestInputModule_nativeDiagDrawRegion(
+        JNIEnv *env, jobject, jbyteArray rgba, jint dx, jint dy, jint dw, jint dh) {
+    if (rgba == nullptr || dx < 0 || dy < 0 || dw <= 0 || dh <= 0) return JNI_FALSE;
+    const size_t regionBytes = static_cast<size_t>(dw) * static_cast<size_t>(dh) * 4u;
+    if (static_cast<size_t>(env->GetArrayLength(rgba)) != regionBytes) return JNI_FALSE;
+    std::lock_guard<std::mutex> lock(quest_input::diagState.mutex);
+    auto &s = quest_input::diagState;
+    if (!s.visible || s.width <= 0 || s.height <= 0 ||
+        dx + dw > s.width || dy + dh > s.height || s.pixels.empty()) return JNI_FALSE;
+    s.scratch.resize(regionBytes);
+    env->GetByteArrayRegion(rgba, 0, static_cast<jsize>(regionBytes),
+                            reinterpret_cast<jbyte *>(s.scratch.data()));
+    const size_t fullRowBytes = static_cast<size_t>(s.width) * 4u;
+    const size_t regRowBytes = static_cast<size_t>(dw) * 4u;
+    const size_t xOffsetBytes = static_cast<size_t>(dx) * 4u;
+    for (int row = 0; row < dh; ++row) {
+        const size_t glY = static_cast<size_t>(s.height - 1 - (dy + row));
+        std::memcpy(s.pixels.data() + glY * fullRowBytes + xOffsetBytes,
+                    s.scratch.data() + static_cast<size_t>(row) * regRowBytes,
+                    regRowBytes);
+    }
+    s.pendingDirty.include(dx, s.height - (dy + dh), dw, dh);
+    ++s.revision;
+    return JNI_TRUE;
+}
