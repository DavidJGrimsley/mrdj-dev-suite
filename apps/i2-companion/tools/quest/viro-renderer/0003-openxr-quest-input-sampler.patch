+// App-owned addition to ReactVision/virocore v3.0.3 (MIT) for the Neo Rock 'Em
+// Sock 'Em Robots Quest controller diagnostics. Included once, by
+// VROSceneRendererOpenXR.cpp: the JNI entry points and the state below must
+// exist in exactly one translation unit (the same rule as QuestPanelLayer.h).
+//
+// The render thread publishes VROInputControllerOpenXR's raw per-frame input
+// (QuestRawInput) into a bounded ring, updates render-thread diagnostic hand
+// markers from the same current-frame sample before VRORenderer::prepareFrame,
+// and submits an optional sky diagnostics XrCompositionLayerQuad under the
+// projection layer. It adds no OpenXR session, action, binding or space.
+#pragma once
+#include <jni.h>
+#include <openxr/openxr.h>
+#include <GLES3/gl3.h>
+#include <android/log.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <time.h>
+#include <vector>
+#include "VROInputControllerOpenXR.h"
+#include "VROInputPresenter.h"
+#include "VRONode.h"
+#include "VROSphere.h"
+#include "VROBox.h"
+#include "VROMaterial.h"
+
+namespace quest_input {
+// Bumped when the JNI contract or the sample layout changes; QuestInputModule checks it.
+constexpr int kVersion = 1;
+constexpr int kCapacity = 64;  // about 0.5 s at 120 Hz
+
+// Per sample: three int64 values, then ints, then floats. Hands are left, right.
+constexpr int kLongsPerSample = 3;   // seq, XrTime predicted display time, CLOCK_MONOTONIC capture
+constexpr int kIntsPerHand = 5;      // locate result, location flags, velocity flags, active bits, button bits
+constexpr int kIntsPerSample = 5 + 2 * kIntsPerHand;  // sync result, session state, actions ready, generation, ref epoch
+constexpr int kFloatsPerHand = 17;   // position 3, orientation xyzw 4, linear 3, angular 3, trigger, squeeze, stick x, y
+constexpr int kFloatsPerSample = 2 * kFloatsPerHand;
+constexpr int kHeaderLongs = 14;
+
+enum ActiveBit { kPose = 1, kTrigger = 2, kSqueeze = 4, kThumbstick = 8, kPrimary = 16, kSecondary = 32, kMenu = 64 };
+enum ButtonBit { kPrimaryDown = 1, kSecondaryDown = 2, kMenuDown = 4 };
+
+struct Slot {
+    int64_t longs[kLongsPerSample];
+    int32_t ints[kIntsPerSample];
+    float   floats[kFloatsPerSample];
+};
+
+struct State {
+    std::mutex mutex;
+    std::array<Slot, kCapacity> ring;
+    int64_t  nextSeq = 1;    // never reset, so a reader cursor cannot alias across sessions
+    int64_t  oldestSeq = 0;  // 0 while the ring is empty
+    int64_t  latestSeq = 0;
+    uint32_t generation = 0; // one per renderer session; 0 before the first
+    bool     live = false;
+    bool     actionsReady = false;
+    bool     haveOrigin = false;
+    int64_t  originDisplayTime = 0;
+    int64_t  originMonotonic = 0;
+    int64_t  published = 0;
+    int64_t  framesWithoutInput = 0;
+    int64_t  rejected = 0;   // publishes from a session that is no longer current
+    std::string profiles[2];
+};
+static State state;
+static std::atomic<bool> markersEnabled{false};
+
+inline int64_t monotonicNow() {
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<int64_t>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+}
+
+// Caller holds state.mutex.
+inline void clearRingLocked() {
+    state.oldestSeq = 0;
+    state.latestSeq = 0;
+    state.haveOrigin = false;
+    state.originDisplayTime = 0;
+    state.originMonotonic = 0;
+    state.published = 0;
+    state.framesWithoutInput = 0;
+    state.profiles[0].clear();
+    state.profiles[1].clear();
+}
+
+// Render-thread diagnostic markers (blue left, orange right, 15 cm aim ray, yellow inferred tag).
+struct HandMarkerNodes {
+    std::shared_ptr<VRONode> root;
+    std::shared_ptr<VRONode> inferred;
+};
+
+struct MarkerState {
+    std::weak_ptr<VRONode> presenterRoot;
+    HandMarkerNodes hands[2];
+};
+static MarkerState markerState;
+
+inline std::shared_ptr<VROMaterial> makeMarkerMaterial(VROVector4f color) {
+    auto mat = std::make_shared<VROMaterial>();
+    mat->setLightingModel(VROLightingModel::Constant);
+    mat->getDiffuse().setColor(color);
+    mat->setReceivesShadows(false);
+    return mat;
+}
+
+inline HandMarkerNodes createHandMarkerNodes(VROVector4f sphereColor) {
+    constexpr float kMarkerRadius = 0.012f;
+    constexpr float kRayLength    = 0.15f;
+    HandMarkerNodes out;
+
+    out.root = std::make_shared<VRONode>();
+    out.root->setName("QuestRawHandMarker");
+    out.root->setSelectable(false);
+    out.root->setIgnoreEventHandling(true);
+    out.root->setHidden(true);
+
+    auto sphereGeom = VROSphere::createSphere(kMarkerRadius, 12, 12, true);
+    sphereGeom->setMaterials({ makeMarkerMaterial(sphereColor) });
+    auto sphereNode = std::make_shared<VRONode>();
+    sphereNode->setGeometry(sphereGeom);
+    sphereNode->setSelectable(false);
+    sphereNode->setIgnoreEventHandling(true);
+    out.root->addChildNode(sphereNode);
+
+    auto rayGeom = VROBox::createBox(0.003f, 0.003f, kRayLength);
+    rayGeom->setMaterials({ makeMarkerMaterial({ 0.886f, 0.910f, 0.941f, 1.0f }) });
+    auto rayNode = std::make_shared<VRONode>();
+    rayNode->setPosition({ 0.0f, 0.0f, -kRayLength * 0.5f });
+    rayNode->setGeometry(rayGeom);
+    rayNode->setSelectable(false);
+    rayNode->setIgnoreEventHandling(true);
+    out.root->addChildNode(rayNode);
+
+    auto inferredGeom = VROBox::createBox(0.01f, 0.01f, 0.01f);
+    inferredGeom->setMaterials({ makeMarkerMaterial({ 0.980f, 0.800f, 0.082f, 1.0f }) });
+    out.inferred = std::make_shared<VRONode>();
+    out.inferred->setPosition({ 0.0f, kMarkerRadius * 2.2f, 0.0f });
+    out.inferred->setGeometry(inferredGeom);
+    out.inferred->setSelectable(false);
+    out.inferred->setIgnoreEventHandling(true);
+    out.inferred->setHidden(true);
+    out.root->addChildNode(out.inferred);
+
+    return out;
+}
+
+// Render thread only. Detaches marker nodes on scene change or disable.
+inline void resetMarkers() {
+    for (int i = 0; i < 2; ++i) {
+        if (markerState.hands[i].root) {
+            markerState.hands[i].root->setHidden(true);
+            markerState.hands[i].root->removeFromParentNode();
+            markerState.hands[i].root.reset();
+        }
+        markerState.hands[i].inferred.reset();
+    }
+    markerState.presenterRoot.reset();
+}
+
+// Safe on teardown thread (after render thread joins): drops node refs without passert_thread.
+inline void clearMarkerRefs() {
+    for (int i = 0; i < 2; ++i) {
+        markerState.hands[i].root.reset();
+        markerState.hands[i].inferred.reset();
+    }
+    markerState.presenterRoot.reset();
+}
+
+// Render thread only, called before VRORenderer::prepareFrame so transforms and sort keys
+// reflect this exact frame's predictedDisplayTime with zero bridge or queue lag.
+inline void updateMarkers(const std::shared_ptr<VRONode> &presenterRoot,
+                          const QuestRawInput &raw,
+                          int sessionState) {
+    if (!markersEnabled.load(std::memory_order_relaxed) || !presenterRoot) {
+        if (markerState.hands[0].root || markerState.hands[1].root) resetMarkers();
+        return;
+    }
+    if (markerState.presenterRoot.lock() != presenterRoot) {
+        resetMarkers();
+        markerState.presenterRoot = presenterRoot;
+        markerState.hands[0] = createHandMarkerNodes({ 0.220f, 0.741f, 0.973f, 1.0f });
+        markerState.hands[1] = createHandMarkerNodes({ 0.976f, 0.451f, 0.086f, 1.0f });
+        presenterRoot->addChildNode(markerState.hands[0].root);
+        presenterRoot->addChildNode(markerState.hands[1].root);
+    }
+    const bool focused = (sessionState == XR_SESSION_STATE_FOCUSED && raw.syncResult == XR_SUCCESS);
+    const QuestRawHand *src[2] = { &raw.left, &raw.right };
+    for (int i = 0; i < 2; ++i) {
+        const QuestRawHand &hand = *src[i];
+        HandMarkerNodes &dst = markerState.hands[i];
+        const bool locateOk = XR_SUCCEEDED(hand.locateResult);
+        const bool posValid = locateOk && (hand.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) != 0;
+        const bool oriValid = locateOk && (hand.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT) != 0;
+        const bool posTracked = posValid && (hand.locationFlags & XR_SPACE_LOCATION_POSITION_TRACKED_BIT) != 0;
+        const bool oriTracked = oriValid && (hand.locationFlags & XR_SPACE_LOCATION_ORIENTATION_TRACKED_BIT) != 0;
+        const auto &p = hand.pose.position;
+        const auto &q = hand.pose.orientation;
+        const float qn = std::sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w);
+        const bool validPose = focused && hand.poseActive && posValid && oriValid &&
+            std::isfinite(p.x) && std::isfinite(p.y) && std::isfinite(p.z) &&
+            std::isfinite(q.x) && std::isfinite(q.y) && std::isfinite(q.z) && std::isfinite(q.w) &&
+            qn > 0.0f && std::fabs(qn - 1.0f) <= 0.05f;
+        if (validPose) {
+            dst.root->setPosition({ p.x, p.y, p.z });
+            dst.root->setRotation(VROQuaternion(q.x / qn, q.y / qn, q.z / qn, q.w / qn));
+            dst.root->setHidden(false);
+            dst.inferred->setHidden(posTracked && oriTracked);
+        } else {
+            dst.root->setHidden(true);
+            dst.inferred->setHidden(true);
+        }
+    }
+}
+
+// Constructor of a renderer whose session and action set now exist. Returns its generation.
+inline uint32_t beginSession(bool actionsReady) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    clearRingLocked();
+    state.generation += 1;
+    if (state.generation == 0) state.generation = 1;
+    state.live = true;
+    state.actionsReady = actionsReady;
+    return state.generation;
+}
+
+// destroySession of that renderer. Idempotent, and a no-op once a newer session began.
+inline void endSession(uint32_t generation) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (generation == 0 || generation != state.generation || !state.live) return;
+    state.live = false;
+    state.actionsReady = false;
+    clearRingLocked();
+}
+
+inline void noteFrameWithoutInput(uint32_t generation) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.live && generation == state.generation) ++state.framesWithoutInput;
+}
+
+inline void packHand(const QuestRawHand &hand, int32_t *ints, float *floats) {
+    ints[0] = static_cast<int32_t>(hand.locateResult);
+    ints[1] = static_cast<int32_t>(hand.locationFlags & 0xffffffffu);
+    ints[2] = static_cast<int32_t>(hand.velocityFlags & 0xffffffffu);
+    ints[3] = (hand.poseActive ? kPose : 0) | (hand.triggerActive ? kTrigger : 0) |
+              (hand.squeezeActive ? kSqueeze : 0) | (hand.thumbstickActive ? kThumbstick : 0) |
+              (hand.primaryActive ? kPrimary : 0) | (hand.secondaryActive ? kSecondary : 0) |
+              (hand.menuActive ? kMenu : 0);
+    ints[4] = (hand.primary ? kPrimaryDown : 0) | (hand.secondary ? kSecondaryDown : 0) |
+              (hand.menu ? kMenuDown : 0);
+    const XrPosef &p = hand.pose;
+    const float values[kFloatsPerHand] = {
+        p.position.x, p.position.y, p.position.z,
+        p.orientation.x, p.orientation.y, p.orientation.z, p.orientation.w,
+        hand.linearVelocity.x, hand.linearVelocity.y, hand.linearVelocity.z,
+        hand.angularVelocity.x, hand.angularVelocity.y, hand.angularVelocity.z,
+        hand.trigger, hand.squeeze, hand.thumbstick.x, hand.thumbstick.y,
+    };
+    std::memcpy(floats, values, sizeof(values));
+}
+
+// Render thread, once per frame that ran sync/onProcess.
+inline void publish(uint32_t generation, const QuestRawInput &raw, XrTime displayTime,
+                    int sessionState, int refEpoch) {
+    Slot slot;
+    slot.longs[1] = static_cast<int64_t>(displayTime);
+    slot.longs[2] = monotonicNow();
+    slot.ints[0] = static_cast<int32_t>(raw.syncResult);
+    slot.ints[1] = sessionState;
+    slot.ints[2] = raw.actionsReady ? 1 : 0;
+    slot.ints[3] = static_cast<int32_t>(generation);
+    slot.ints[4] = refEpoch;
+    packHand(raw.left, slot.ints + 5, slot.floats);
+    packHand(raw.right, slot.ints + 5 + kIntsPerHand, slot.floats + kFloatsPerHand);
+
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (!state.live || generation != state.generation) {
+        ++state.rejected;
+        return;
+    }
+    const int64_t seq = state.nextSeq++;
+    slot.longs[0] = seq;
+    state.ring[static_cast<size_t>(seq % kCapacity)] = slot;
+    if (state.oldestSeq == 0) state.oldestSeq = seq;
+    state.latestSeq = seq;
+    if (state.latestSeq - state.oldestSeq + 1 > kCapacity) state.oldestSeq = state.latestSeq - kCapacity + 1;
+    if (!state.haveOrigin) {
+        state.haveOrigin = true;
+        state.originDisplayTime = slot.longs[1];
+        state.originMonotonic = slot.longs[2];
+    }
+    ++state.published;
+}
+
+// Render thread. The OpenXR calls run before the lock. Returns true once a hand has a profile.
+inline bool refreshProfiles(uint32_t generation, XrInstance instance, XrSession session) {
+    static const char *kHands[2] = {"/user/hand/left", "/user/hand/right"};
+    std::string names[2];
+    for (int i = 0; i < 2; ++i) {
+        XrPath handPath = XR_NULL_PATH;
+        if (XR_FAILED(xrStringToPath(instance, kHands[i], &handPath))) continue;
+        XrInteractionProfileState profile = {XR_TYPE_INTERACTION_PROFILE_STATE};
+        if (XR_FAILED(xrGetCurrentInteractionProfile(session, handPath, &profile)) ||
+            profile.interactionProfile == XR_NULL_PATH) continue;
+        char buffer[XR_MAX_PATH_LENGTH];
+        uint32_t length = 0;
+        if (XR_SUCCEEDED(xrPathToString(instance, profile.interactionProfile,
+                                        XR_MAX_PATH_LENGTH, &length, buffer)) && length > 0) {
+            names[i].assign(buffer, length - 1);
+        }
+    }
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (!state.live || generation != state.generation) return true;
+    state.profiles[0] = names[0];
+    state.profiles[1] = names[1];
+    return !names[0].empty() || !names[1].empty();
+}
+
+struct DirtyRect {
+    int x = 0, y = 0, w = 0, h = 0;
+    bool empty() const { return w <= 0 || h <= 0; }
+    void include(int rx, int ry, int rw, int rh) {
+        if (rw <= 0 || rh <= 0) return;
+        if (empty()) { x = rx; y = ry; w = rw; h = rh; return; }
+        const int x1 = std::min(x, rx);
+        const int y1 = std::min(y, ry);
+        const int x2 = std::max(x + w, rx + rw);
+        const int y2 = std::max(y + h, ry + rh);
+        x = x1; y = y1; w = x2 - x1; h = y2 - y1;
+    }
+    void clamp(int maxW, int maxH) {
+        if (empty()) return;
+        const int x1 = std::max(0, x);
+        const int y1 = std::max(0, y);
+        const int x2 = std::min(maxW, x + w);
+        const int y2 = std::min(maxH, y + h);
+        x = x1; y = y1; w = x2 - x1; h = y2 - y1;
+    }
+};
+
+// Sky diagnostics panel quad layer (under the projection layer, same architecture as QuestPanelLayer.h).
+struct DiagState {
+    std::mutex mutex;
+    bool visible = false;
+    int status = 0;  // 0 hidden/pending, 1 submitted, -1 failed
+    uint64_t revision = 0;
+    int width = 0, height = 0;
+    float widthM = 1.8f, heightM = 1.0125f;
+    XrPosef pose = {{0.38268f, 0, 0, 0.92388f}, {0, 1.27f, -1.27f}};
+    DirtyRect pendingDirty;
+    std::vector<uint8_t> pixels;
+    std::vector<uint8_t> scratch;
+};
+static DiagState diagState;
+
+inline bool readDiagPose(JNIEnv *env, jfloatArray values, XrPosef *pose) {
+    if (values == nullptr || env->GetArrayLength(values) != 7) return false;
+    float p[7];
+    env->GetFloatArrayRegion(values, 0, 7, p);
+    for (float v : p) {
+        if (!std::isfinite(v)) return false;
+    }
+    const float norm = std::sqrt(p[3] * p[3] + p[4] * p[4] + p[5] * p[5] + p[6] * p[6]);
+    if (norm < 0.5f || norm > 1.5f) return false;
+    *pose = {{p[3] / norm, p[4] / norm, p[5] / norm, p[6] / norm}, {p[0], p[1], p[2]}};
+    return true;
+}
+
+class DiagLayer {
+    XrSwapchain _swapchain = XR_NULL_HANDLE;
+    std::vector<XrSwapchainImageOpenGLESKHR> _images;
+    std::vector<DirtyRect> _imageDirty;
+    uint64_t _revision = 0;
+    int _width = 0, _height = 0;
+    XrCompositionLayerQuad _layer = { XR_TYPE_COMPOSITION_LAYER_QUAD };
+
+    void destroySwapchain() {
+        if (_swapchain) xrDestroySwapchain(_swapchain);
+        _swapchain = XR_NULL_HANDLE;
+        _images.clear();
+        _imageDirty.clear();
+        _revision = 0;
+    }
+
+public:
+    ~DiagLayer() { destroySwapchain(); }
+
+    const XrCompositionLayerBaseHeader *prepare(XrSession session, XrSpace space) {
+        std::lock_guard<std::mutex> lock(diagState.mutex);
+        auto &s = diagState;
+        if (!s.visible || s.pixels.empty() || s.status < 0) return nullptr;
+        if (_swapchain && (_width != s.width || _height != s.height)) destroySwapchain();
+        if (!_swapchain) {
+            uint32_t count = 0;
+            if (XR_FAILED(xrEnumerateSwapchainFormats(session, 0, &count, nullptr))) return nullptr;
+            std::vector<int64_t> formats(count);
+            if (XR_FAILED(xrEnumerateSwapchainFormats(session, count, &count, formats.data()))) return nullptr;
+            const int64_t format = std::find(formats.begin(), formats.end(), GL_SRGB8_ALPHA8) != formats.end()
+                ? GL_SRGB8_ALPHA8 : GL_RGBA8;
+            if (std::find(formats.begin(), formats.end(), format) == formats.end()) {
+                s.status = -1; return nullptr;
+            }
+            XrSwapchainCreateInfo info = { XR_TYPE_SWAPCHAIN_CREATE_INFO };
+            info.usageFlags = XR_SWAPCHAIN_USAGE_SAMPLED_BIT | XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_TRANSFER_DST_BIT;
+            info.format = format; info.sampleCount = 1;
+            info.width = s.width; info.height = s.height;
+            info.faceCount = 1; info.arraySize = 1; info.mipCount = 1;
+            if (XR_FAILED(xrCreateSwapchain(session, &info, &_swapchain))) {
+                _swapchain = XR_NULL_HANDLE;
+                s.status = -1; return nullptr;
+            }
+            _width = s.width; _height = s.height;
+            if (XR_FAILED(xrEnumerateSwapchainImages(_swapchain, 0, &count, nullptr))) {
+                destroySwapchain(); return nullptr;
+            }
+            _images.resize(count, {XR_TYPE_SWAPCHAIN_IMAGE_OPENGL_ES_KHR});
+            if (XR_FAILED(xrEnumerateSwapchainImages(_swapchain, count, &count,
+                reinterpret_cast<XrSwapchainImageBaseHeader *>(_images.data())))) {
+                destroySwapchain(); return nullptr;
+            }
+            _imageDirty.assign(_images.size(), {0, 0, _width, _height});
+            s.pendingDirty = {};
+        } else if (_revision != s.revision) {
+            if (s.pendingDirty.empty()) {
+                for (auto &d : _imageDirty) d = {0, 0, _width, _height};
+            } else {
+                s.pendingDirty.clamp(_width, _height);
+                for (auto &d : _imageDirty) {
+                    d.include(s.pendingDirty.x, s.pendingDirty.y, s.pendingDirty.w, s.pendingDirty.h);
+                    d.clamp(_width, _height);
+                }
+                s.pendingDirty = {};
+            }
+        }
+        if (_revision != s.revision) {
+            uint32_t index = 0;
+            XrSwapchainImageAcquireInfo acquire = {XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+            if (XR_FAILED(xrAcquireSwapchainImage(_swapchain, &acquire, &index))) return nullptr;
+            XrSwapchainImageWaitInfo wait = {XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+            wait.timeout = XR_INFINITE_DURATION;
+            if (XR_FAILED(xrWaitSwapchainImage(_swapchain, &wait))) {
+                XrSwapchainImageReleaseInfo release = {XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+                xrReleaseSwapchainImage(_swapchain, &release);
+                return nullptr;
+            }
+            const DirtyRect dirty = index < _imageDirty.size()
+                ? _imageDirty[index]
+                : DirtyRect{0, 0, _width, _height};
+            GLenum uploadError = GL_NO_ERROR;
+            GLenum target = GL_TEXTURE_2D;
+            if (!dirty.empty()) {
+                GLint texture = 0, arrayTexture = 0, alignment = 0, unpackBuffer = 0;
+                GLint rowLength = 0, skipRows = 0, skipPixels = 0;
+                glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+                glGetIntegerv(GL_TEXTURE_BINDING_2D_ARRAY, &arrayTexture);
+                glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+                glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpackBuffer);
+                glGetIntegerv(GL_UNPACK_ROW_LENGTH, &rowLength);
+                glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skipRows);
+                glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skipPixels);
+                for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i) {}
+                glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+                glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+                glPixelStorei(GL_UNPACK_ROW_LENGTH, _width);
+                glPixelStorei(GL_UNPACK_SKIP_ROWS, dirty.y);
+                glPixelStorei(GL_UNPACK_SKIP_PIXELS, dirty.x);
+                glBindTexture(GL_TEXTURE_2D, _images[index].image);
+                uploadError = glGetError();
+                if (uploadError == GL_INVALID_OPERATION) {
+                    target = GL_TEXTURE_2D_ARRAY;
+                    glBindTexture(target, _images[index].image);
+                    uploadError = glGetError();
+                }
+                if (uploadError == GL_NO_ERROR) {
+                    if (target == GL_TEXTURE_2D_ARRAY) {
+                        glTexSubImage3D(target, 0, dirty.x, dirty.y, 0, dirty.w, dirty.h, 1,
