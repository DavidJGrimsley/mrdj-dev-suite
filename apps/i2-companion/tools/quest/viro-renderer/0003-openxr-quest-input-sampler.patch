+// Copies every sample newer than afterSeq (at most kCapacity) and the header.
+// Returns the sample count, or -1 when an array is too small.
+extern "C" JNIEXPORT jint JNICALL
+Java_expo_modules_questinput_QuestInputModule_nativeRead(
+        JNIEnv *env, jobject, jlong afterSeq, jlongArray header, jlongArray longs,
+        jintArray ints, jfloatArray floats) {
+    using namespace quest_input;
+    if (header == nullptr || longs == nullptr || ints == nullptr || floats == nullptr ||
+        env->GetArrayLength(header) < kHeaderLongs ||
+        env->GetArrayLength(longs) < kCapacity * kLongsPerSample ||
+        env->GetArrayLength(ints) < kCapacity * kIntsPerSample ||
+        env->GetArrayLength(floats) < kCapacity * kFloatsPerSample) return -1;
+
+    // Copied under the lock, handed to JNI after it is released.
+    static thread_local std::array<Slot, kCapacity> copy;
+    jlong head[kHeaderLongs] = {};
+    int count = 0;
+    {
+        std::lock_guard<std::mutex> lock(state.mutex);
+        head[0] = kVersion;
+        head[1] = state.generation;
+        head[2] = state.live ? 1 : 0;
+        head[3] = state.actionsReady ? 1 : 0;
+        head[4] = state.latestSeq;
+        head[5] = state.oldestSeq;
+        head[6] = state.published;
+        head[7] = state.framesWithoutInput;
+        head[8] = state.rejected;
+        head[10] = state.originDisplayTime;
+        head[11] = state.originMonotonic;
+        head[12] = state.haveOrigin ? 1 : 0;
+        head[13] = kCapacity;
+        if (state.latestSeq > 0) {
+            const int64_t first = afterSeq + 1 > state.oldestSeq ? afterSeq + 1 : state.oldestSeq;
+            for (int64_t seq = first; seq <= state.latestSeq && count < kCapacity; ++seq)
+                copy[count++] = state.ring[static_cast<size_t>(seq % kCapacity)];
+        }
+    }
+    head[9] = monotonicNow();
+    for (int i = 0; i < count; ++i) {
+        env->SetLongArrayRegion(longs, i * kLongsPerSample, kLongsPerSample,
+                                reinterpret_cast<const jlong *>(copy[i].longs));
+        env->SetIntArrayRegion(ints, i * kIntsPerSample, kIntsPerSample,
+                               reinterpret_cast<const jint *>(copy[i].ints));
+        env->SetFloatArrayRegion(floats, i * kFloatsPerSample, kFloatsPerSample, copy[i].floats);
+    }
+    env->SetLongArrayRegion(header, 0, kHeaderLongs, head);
+    return count;
+}
