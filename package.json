{
  "name": "mr-djs-dev-suite",
  "version": "0.1.25",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "description": "Personal AI dev-suite for Expo developers: doctor, onboarding, automation, and knowledge base",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidJGrimsley/mrdj-dev-suite.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:knowledge": "pnpm --filter @mr.dj2u/knowledge build",
    "build:plugin": "pnpm --filter @mr.dj2u/knowledge build:plugin",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "typecheck": "pnpm type-check",
    "test": "turbo run test",
    "test:matrix": "pnpm --filter @mr.dj2u/cli build && node packages/cli/scripts/run-vitest.mjs packages/cli/tests/generator-matrix.test.ts",
    "ci": "pnpm type-check && pnpm lint && pnpm build && pnpm test",
    "ci:repo": "pnpm run ci && pnpm check:agent-bundles",
    "check:publish-manifests": "node scripts/verify-publish-manifest.mjs",
    "check:agent-bundles": "pnpm --filter @mr.dj2u/cli check:bundles",
    "clean": "turbo run clean && node -e \"const fs=require('node:fs'); for (const p of ['node_modules','dist']) fs.rmSync(p,{recursive:true,force:true});\"",
    "doctor": "node packages/cli/dist/cli.js doctor",
    "doctor:ci": "node packages/cli/dist/cli.js doctor --ci",
    "onboard": "node packages/cli/dist/cli.js onboard",
    "publish:mds": "changeset publish",
    "version:packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "create-expo-super-stack": "node packages/create-expo-super-stack/dist/cli.js",
    "test-and-iterate": "node packages/cli/dist/cli.js test-and-iterate",
    "ship:test": "node packages/cli/dist/cli.js test-and-iterate --base test",
    "push:merge": "node packages/cli/dist/cli.js push-merge-loop --base test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^8.57.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.1.0",
    "turbo": "^2.9.12",
    "typescript": "^5.9.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
